<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Do You Love Me? ❤️</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    height: 100vh;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #ff758c, #ff7eb3, #fad0c4);
}

/* Floating background */
.background {
    position: fixed;
    inset: 0;
    overflow: hidden;
}

.floating {
    position: absolute;
    bottom: -80px;
    animation: floatUp linear infinite;
    opacity: .8;
}

@keyframes floatUp {
    from {
        transform: translateY(0) rotate(0);
        opacity: 0;
    }
    15% {
        opacity: 1;
    }
    to {
        transform: translateY(-120vh) rotate(360deg);
        opacity: 0;
    }
}

/* Card */
.card {
    position: absolute;
    z-index: 2;
    width: 90%;
    max-width: 450px;
    min-height: 540px;
    padding: 30px;
    background: rgba(255,255,255,.96);
    border-radius: 30px;
    box-shadow: 0 20px 50px rgba(0,0,0,.3);
    text-align: center;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
}

#questionPage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.heart {
    font-size: 80px;
    animation: heartbeat 1s infinite;
}

@keyframes heartbeat {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.2); }
}

h1 {
    color: #e91e63;
    font-size: 36px;
}

.subtitle {
    color: #777;
    margin-bottom: 35px;
}

/* Buttons area */
.buttons {
    position: relative;
    width: 100%;
    height: 100px;
}

button {
    border: none;
    border-radius: 50px;
    padding: 15px 30px;
    color: white;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0,0,0,.2);
}

#yesButton {
    background: linear-gradient(45deg,#ff1744,#ff4081);
    margin-right: 15px;
}

#noButton {
    position: absolute;
    background: #777;
    left: 55%;
    top: 5px;
    transition: none;
}

/* Love page */
#lovePage {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.bigLove {
    font-size: 80px;
    animation: heartbeat 1s infinite;
}

.loveText {
    color: #e91e63;
    font-size: 38px;
    font-weight: bold;
    min-height: 50px;
}

.couple {
    font-size: 75px;
    animation: couplePop .8s infinite alternate;
}

@keyframes couplePop {
    from { transform: scale(1); }
    to { transform: scale(1.15) rotate(3deg); }
}

.message {
    color: #666;
    font-size: 18px;
    margin: 20px;
}

/* Confetti */
.confetti {
    position: fixed;
    top: -30px;
    z-index: 10;
    animation: fall 3s linear forwards;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(720deg);
    }
}
</style>
</head>

<body>

<div class="background" id="background"></div>

<!-- FIRST PAGE -->
<div class="card" id="questionPage">

    <div class="heart">❤️</div>

    <h1>Do you love me?</h1>

    <div class="subtitle">
        Be honest... 😏💕
    </div>

    <div class="buttons">

        <button id="yesButton" onclick="sayYes()">
            YES ❤️
        </button>

        <button id="noButton">
            NO 😏
        </button>

    </div>

</div>


<!-- SECOND PAGE -->
<div class="card" id="lovePage">

    <div class="bigLove">💖</div>

    <div class="loveText" id="loveText"></div>

    <div class="couple">
        🥰💑🥰
    </div>

    <div class="message">
        You just made my heart very happy! 💕
    </div>

    <div style="font-size:45px;">
        🌹 ❤️ 🌹
    </div>

</div>


<script>

/* Floating background */
const background = document.getElementById("background");

const emojis = [
    "❤️","💕","💖","💗","💘","🌹","✨","🥰"
];

function createFloating() {

    const item = document.createElement("div");

    item.className = "floating";
    item.innerHTML =
        emojis[Math.floor(Math.random()*emojis.length)];

    item.style.left =
        Math.random()*100 + "vw";

    item.style.fontSize =
        (20 + Math.random()*35) + "px";

    item.style.animationDuration =
        (5 + Math.random()*7) + "s";

    background.appendChild(item);

    setTimeout(() => item.remove(),13000);
}

setInterval(createFloating,400);


/* ==========================
   FAST MOVING NO BUTTON
========================== */

const noButton = document.getElementById("noButton");
const buttonsArea = document.querySelector(".buttons");

function escapeButton() {

    const areaWidth = buttonsArea.clientWidth;
    const areaHeight = buttonsArea.clientHeight;

    const buttonWidth = noButton.offsetWidth;
    const buttonHeight = noButton.offsetHeight;

    const maxX = areaWidth - buttonWidth;
    const maxY = areaHeight - buttonHeight;

    const x = Math.random() * maxX;
    const y = Math.random() * maxY;

    noButton.style.left = x + "px";
    noButton.style.top = y + "px";
}

/* Move extremely fast when approaching/touching */
noButton.addEventListener("mouseenter", escapeButton);

noButton.addEventListener("touchstart", function(e) {
    e.preventDefault();
    escapeButton();
});

/* Also move when clicked */
noButton.addEventListener("click", function(e) {
    e.preventDefault();
    escapeButton();
});


/* ==========================
   YES BUTTON
========================== */

function sayYes() {

    document.getElementById("questionPage").style.display = "none";

    document.getElementById("lovePage").style.display = "flex";

    createConfetti();

    createLoveHearts();

    typeMessage();
}


/* Typewriter */
function typeMessage() {

    const text = "I LOVE YOU TOO ❤️";

    const element =
        document.getElementById("loveText");

    let i = 0;

    const timer = setInterval(() => {

        element.innerHTML += text.charAt(i);

        i++;

        if(i >= text.length) {
            clearInterval(timer);
        }

    },120);
}


/* Confetti */
function createConfetti() {

    for(let i=0;i<100;i++) {

        const confetti =
            document.createElement("div");

        confetti.className = "confetti";

        confetti.innerHTML =
            ["❤️","💕","💖","✨","🌹","💑"]
            [Math.floor(Math.random()*6)];

        confetti.style.left =
            Math.random()*100 + "vw";

        confetti.style.fontSize =
            (15+Math.random()*25) + "px";

        confetti.style.animationDelay =
            Math.random()*2 + "s";

        document.body.appendChild(confetti);

        setTimeout(() => confetti.remove(),5000);
    }
}


/* Extra hearts */
function createLoveHearts() {

    for(let i=0;i<50;i++) {

        const heart =
            document.createElement("div");

        heart.className = "floating";

        heart.innerHTML =
            ["❤️","💕","💖","💑","🥰"]
            [Math.floor(Math.random()*5)];

        heart.style.left =
            Math.random()*100 + "vw";

        heart.style.bottom =
            Math.random()*20 + "vh";

        heart.style.fontSize =
            (25+Math.random()*45) + "px";

        heart.style.animationDuration =
            (3+Math.random()*4) + "s";

        document.body.appendChild(heart);

        setTimeout(() => heart.remove(),8000);
    }
}

</script>

</body>
</html>
